[Unit]
Description=Local Events Intelligence Board Refresh
After=network-online.target local-events-dashboard.service
Wants=network-online.target

[Service]
Type=oneshot

User=onsiteadmin
Group=onsiteadmin

WorkingDirectory=/mnt/appdata/ha-services/local-events

Environment=PYTHONUNBUFFERED=1

ExecStart=/mnt/appdata/ha-services/local-events/bin/refresh_local_events.sh

TimeoutStartSec=0

Nice=10
