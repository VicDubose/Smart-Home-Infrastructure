[Unit]
Description=Jarvis unattended post-ARM movie validation router
After=network-online.target docker.service
Wants=network-online.target
ConditionPathIsMountPoint=/mnt/media
ConditionPathExists=/mnt/appdata/arm/media/completed

[Service]
Type=oneshot
WorkingDirectory=%h
ExecStart=/usr/bin/flock -n -E 0 /run/user/%U/jarvis-media-ingest.lock /usr/bin/python3 -u %h/rdp-scripts/Jarvis/media/jarvis_movie_arm_router.py --scan --commit --ai llama3:8b --minimum-age 600
Environment=PYTHONUNBUFFERED=1
Environment=TERM=dumb
Environment=NO_COLOR=1
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
TimeoutStartSec=infinity
KillSignal=SIGINT
